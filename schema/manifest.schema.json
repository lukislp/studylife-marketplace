{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lukislp/studylife-marketplace/schema/manifest.schema.json",
  "title": "StudyAtrium Marketplace Listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "developer", "repository", "requestedScopes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,98}[a-z0-9])?$",
      "description": "Lowercase slug, must match the filename (listings/<id>.json) and the developer's registered ClientId."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "developer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "requestedScopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "redirectUriPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Redirect URI the add-on registers. Required for oauth listings (the default); not allowed for manual ones."
    },
    "install": {
      "enum": ["oauth", "manual"],
      "description": "How the client installs the add-on. Absent means \"oauth\" (one-click install with redirectUriPattern). \"manual\" is for self-hosted add-ons whose redirect URI depends on the user's own deployment: the client shows setupUrl instead of an Install button."
    },
    "setupUrl": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 500,
      "description": "Link to the add-on's setup documentation. Required (and only meaningful) when install is \"manual\"."
    }
  },
  "allOf": [
    {
      "if": { "required": ["install"], "properties": { "install": { "const": "manual" } } },
      "then": { "required": ["setupUrl"], "not": { "required": ["redirectUriPattern"] } },
      "else": { "required": ["redirectUriPattern"], "not": { "required": ["setupUrl"] } }
    }
  ]
}
