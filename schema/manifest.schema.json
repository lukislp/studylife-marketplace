{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lukislp/studylife-marketplace/schema/manifest.schema.json",
  "title": "StudyLife Marketplace Listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "developer", "repository", "requestedScopes", "redirectUriPattern"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,98}[a-z0-9])?$",
      "description": "Lowercase slug, must match the filename (listings/<id>.json) and the developer's registered ClientId."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "developer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "requestedScopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "redirectUriPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
